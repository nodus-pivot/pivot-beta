# Copy to .env.local. Values come from the Supabase dashboard: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Safe for the browser. RLS is the security boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses RLS; used by server actions that create users.
SUPABASE_SECRET_KEY=sb_secret_...
